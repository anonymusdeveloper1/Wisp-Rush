{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["godot"],
  "permissions": {
    "allow": [
      "mcp__godot",
      "Bash(tools/validate.sh)",
      "Bash(tools/validate.sh:*)",
      "Bash(./tools/validate.sh:*)",
      "Bash(node tools/project_map.mjs)",
      "Bash(node tools/project_map.mjs:*)",
      "Bash(/Users/dimitarslezenkovski/Desktop/Godot.app/Contents/MacOS/Godot:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)"
    ],
    "deny": [
      "Edit(/.godot/**)",
      "Write(/.godot/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && { command -v node >/dev/null 2>&1 && node tools/project_map.mjs --check 2>&1 || true; }"
          }
        ]
      }
    ]
  }
}
