# Normalize EOL for all files that Git considers text files (Godot default).
* text=auto eol=lf

# Binary assets — never diff/merge as text.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.psd binary
*.aseprite binary
*.ase binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.glb binary
*.blend binary
*.res binary
*.scn binary
