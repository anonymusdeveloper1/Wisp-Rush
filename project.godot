; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Wisp Rush"
config/description="Wisp Rush — a Godot 4.7 game built with AI agents. See docs/PROJECT_CONTEXT.md."
config/version="0.1.0"
run/main_scene="res://scenes/main/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Forward Plus")
run/flush_stdout_on_print=true
boot_splash/bg_color=Color(0.0667, 0.0824, 0.1294, 1)
boot_splash/image="res://assets/art/branding/wisp_rush_splash_master.png"
config/icon="res://assets/art/branding/wisp_rush_app_icon_master.png"

[autoload]

SaveManager="*res://scripts/autoload/save_manager.gd"
Audio="*res://scripts/autoload/audio_service.gd"
Monetisation="*res://scripts/autoload/monetisation_service.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor]

version_control/plugin_name="GitPlugin"

[global_group]

bosses="Recurring three-phase Reaper boss prefab."
enemies="Active hostile or sliceable enemy prefabs."

[gui]

theme/custom="res://assets/ui/theme/wisp_theme.tres"

